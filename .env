# ===========================================================================
# SIPARTA AI-Models / Edge Script (main_rpi.py) — Environment Variables
# ===========================================================================
# Copy ke .env dan isi sesuai konfigurasi lokal RPi Anda.

# URL FastAPI backend yang menerima laporan dari RPi
# Gunakan IP lokal saat development, Railway URL saat production
SIPARTA_BACKEND_URL=https://siparta-backend.onrender.com

# UUID perangkat ini — daftarkan dulu di tabel iot_devices Supabase
# Kosongkan untuk menggunakan placeholder (00000000-0000-...) saat testing
DEVICE_ID=

# API Key yang sama dengan DEVICE_API_KEY di web-backend/.env
# Kosongkan untuk menonaktifkan autentikasi (mode development)
DEVICE_API_KEY=9d07e6716ce0bb5a277e365b54a321d9
